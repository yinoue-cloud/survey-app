{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/admin.html", "dest": "/public/admin.html" },
    { "src": "/vote.html", "dest": "/public/vote.html" },
    { "src": "/results.html", "dest": "/public/results.html" },
    { "src": "/(.*)", "dest": "/public/admin.html" }
  ]
}
